@startuml backend-modules
!pragma layout smetana
title Backend LLD — implemented Python modules
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #526580
skinparam packageStyle rectangle
skinparam componentBackgroundColor #EEF4FF
skinparam componentBorderColor #365880
skinparam packageBorderColor #9CAEC3
skinparam nodesep 35
skinparam ranksep 55

package "HTTP boundary · app/main.py + app/api" {
  component "app/main.py\nFastAPI + worker lifespan" as main
  component "routes/tasks.py\nsubmit · cancel · retry\nsteps · artifacts · audit" as tasks_api
  component "routes/knowledge.py\nworkspaces · files · KBs\ningest · search" as knowledge_api
  component "routes/auth.py\nroutes/models.py\nroutes/inference.py\nroutes/security.py\nroutes/health.py" as other_api
  component "dependencies.py\nCurrentUser · DatabaseSession\nAppSettings · OllamaProvider" as deps
}

package "Application execution · app/tasks" {
  component "service.py\nvalidate_inputs() · create_task()\ncancel_task() · retry_task()" as service
  component "runtime.py\ntask_worker_loop() · execute_run()\nexecute_coding_workflow()\ncheck_run() · add_step() · add_audit()" as runtime #DBEAFE
  component "coding_react.py\nexecute_coding_react_loop()" as coding
  component "react_loop.py\nrun_react_loop()" as loop
  component "react_actions.py · react_policies.py\nreact_context.py · react_observations.py\ncompletion_validators.py" as controls
}

package "Capabilities" {
  component "routing/router.py\nclassify_task() · route_model()" as routing
  component "tools/registry.py\nToolRegistry · AgentTool\nauthorize() · execute()" as tools
  component "services/hybrid_retrieval.py\nservices/multimodal.py\nservices/procurement.py" as workflows
  component "services/knowledge_ingestion.py\nservices/document_extraction.py\ndocuments/parser.py · chunker.py" as ingestion
  component "services/auth.py\nservices/model_registry.py" as account
  component "artifacts/docx.py\nartifacts/code.py\nartifacts/procurement.py" as artifacts
}

package "Adapters and persistence" {
  component "model_providers/ollama.py\nOllamaModelProvider" as provider
  component "services/qdrant_store.py\nQdrantStore" as vector
  component "services/code_repository.py\nservices/sandbox_client.py" as sandbox
  component "services/file_storage.py\nstore_upload() · resolve_storage_key()" as files
  component "db/models.py · db/session.py\nSQLAlchemy models + SessionLocal" as db
}

main ..> tasks_api : mounts
main ..> knowledge_api : mounts
main ..> other_api : mounts
main ..> runtime : starts / stops worker
tasks_api ..> deps
knowledge_api ..> deps
other_api ..> deps
tasks_api ..> service : task lifecycle
tasks_api ..> runtime : notify_task_worker()
knowledge_api ..> ingestion : background ingestion
knowledge_api ..> files : upload
other_api ..> account
service ..> db : commit task + run
runtime ..> db : FIFO queue / steps / audit
runtime ..> routing
runtime ..> workflows : evidence / comparison
runtime ..> tools
runtime ..> coding : when react_coding_enabled
runtime ..> artifacts : publish outputs
runtime ..> provider
coding ..> loop : callbacks
coding ..> controls
coding ..> tools : governed execution
loop ..> controls : parse / budgets / observations
loop ..> provider : structured action request
tools ..> sandbox : patch / verify
tools ..> vector : knowledge search
workflows ..> ingestion
ingestion ..> provider : embeddings
ingestion ..> vector : index
account ..> provider : health / inference

legend bottom
  Dashed arrow = selected code dependency or call, not network topology.
  Grouped filenames are separate Python modules; no service classes are implied.
  Shared Settings, schemas, errors and repeated adapter/storage dependencies are omitted.
  Runtime is an in-process FIFO worker with an asyncio lock, not a distributed queue.
endlegend
@enduml
